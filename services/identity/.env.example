NODE_ENV=development
PORT=8085

# Loopback only — internal back-office tooling, never internet-facing,
# not fronted by Caddy the way the gateway is (see ../../deploy/NETWORK_TOPOLOGY.md).
BIND_HOST=127.0.0.1

DATABASE_URL=postgresql://postgres:password@localhost:5432/trustbank_identity?schema=public

# 32-byte key, hex-encoded (64 hex chars). Encrypts each staff user's TOTP
# secret at rest — same AES-256-GCM pattern as PAYMENTS_ENCRYPTION_KEY/
# GATEWAY_ENCRYPTION_KEY. Also used to sign short-lived MFA challenge
# tokens (see src/services/mfaChallengeService.js). Generate with:
#   openssl rand -hex 32
IDENTITY_ENCRYPTION_KEY=

# Sliding idle timeout for a staff session — short by design (architecture
# doc section 7: "session timeouts tuned for a banking back-office").
SESSION_IDLE_TIMEOUT_MINUTES=30

# How long the gap between password verification and a valid MFA code
# stays open before the caller has to log in again from scratch.
MFA_CHALLENGE_TTL_MINUTES=5
