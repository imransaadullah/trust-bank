generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// BRANCH
// A tenant's own org-unit hierarchy — owned here, not the Ledger, same
// convention every other cross-service tenant reference in this platform
// already uses (Payments/Compliance store a plain tenantId string, no FK,
// since tenant identity lives only in the Ledger). Built in from the
// start, not deferred until a specific multi-branch tenant asks for it —
// a NATIONAL_MFB's branch structure is a basic expectation of the market
// segment trust-bank targets, not a speculative feature (see
// CORE_BANKING_PLATFORM_ARCHITECTURE.md's Phase 2.5). Ledger's own
// ledger_accounts will get a plain branch_id tag column referencing this
// in a later slice — not built yet.
// ============================================
model Branch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  status    String   @default("active") // 'active' | 'closed'
  createdAt DateTime @default(now()) @map("created_at")

  staffUsers StaffUser[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

// ============================================
// STAFF USER
// The first human identity in this platform — every other credential
// (Ledger admin/operate/platform-admin, Payments/Compliance/Gateway
// admin/operate/tiered keys) is a machine credential, shown-once and
// bearer-token-shaped. A staff member logs in with a password + MFA and
// holds a role, same as SERVICE_CREDENTIAL_MODEL.md's "admin" tier
// already gestures at ("a human... never a long-running service") but
// never actually implemented. role is a fixed set for now (RBAC), not a
// fully generic permission-string system — ABAC is real future scope,
// not built speculatively here (same posture SERVICE_CREDENTIAL_MODEL.md
// takes on its own future tiers).
// ============================================
model StaffUser {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  email        String
  passwordHash String    @map("password_hash") // argon2id
  role         String    // 'teller' | 'branch_manager' | 'compliance_officer' | 'ops_admin'
  branchId     String?   @map("branch_id") // null for tenant-wide roles (ops_admin, compliance_officer)
  status       String    @default("active") // 'active' | 'suspended' | 'revoked'
  mfaSecret    String?   @map("mfa_secret") // AES-256-GCM encrypted TOTP secret — see src/crypto/mfaSecrets.js
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  branch   Branch?         @relation(fields: [branchId], references: [id])
  sessions StaffSession[]
  passwordResetTokens PasswordResetToken[]
  requestedApprovals ApprovalRequest[] @relation("RequestedApprovals")
  approvedApprovals  ApprovalRequest[] @relation("ApprovedApprovals")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("staff_users")
}

// ============================================
// STAFF SESSION
// Same shown-once/hashed/indexed-prefix shape as every other credential
// in this platform (SERVICE_CREDENTIAL_MODEL.md), but short-lived where
// every other credential is long-lived — CORE_BANKING_PLATFORM_
// ARCHITECTURE.md section 7: "session timeouts tuned for a banking
// back-office — short." expiresAt is a sliding idle timeout, extended on
// each authenticated request (see staffSessionService.touch).
// ============================================
model StaffSession {
  id             String   @id @default(uuid())
  staffUserId    String   @map("staff_user_id")
  tokenPrefix    String   @unique @map("token_prefix")
  hashedToken    String   @map("hashed_token")
  status         String   @default("active") // 'active' | 'revoked' | 'expired'
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  staffUser StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([staffUserId])
  @@map("staff_sessions")
}

// ============================================
// PASSWORD RESET TOKEN
// Same shown-once/hashed/prefix-indexed shape as StaffSession — chosen
// over mfaChallengeService.js's stateless-token pattern deliberately: a
// reset token needs real single-use revocation (usedAt) and can sit in
// an inbox for the full expiry window, unlike an MFA challenge token
// consumed within one continuous login flow.
// ============================================
model PasswordResetToken {
  id          String    @id @default(uuid())
  staffUserId String    @map("staff_user_id")
  tokenPrefix String    @unique @map("token_prefix")
  hashedToken String    @map("hashed_token")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  staffUser StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([staffUserId])
  @@map("password_reset_tokens")
}

// ============================================
// TENANT BACKEND CREDENTIAL
// Identity needs its own Ledger/Compliance operate credential per tenant
// to actually execute an approved action — identical shape to the
// gateway's own TenantBackendCredential (services/gateway/prisma/
// schema.prisma), same reasoning: this service is genuinely multi-tenant,
// so it can't hold one shared credential per backend the way
// trustpay-backend's own .env does. Encrypted with IDENTITY_ENCRYPTION_KEY
// — the same key that already encrypts StaffUser.mfaSecret, not a second
// required secret (same "one encryption key per service" convention
// PAYMENTS_ENCRYPTION_KEY already follows for two different secret types).
// ============================================
model TenantBackendCredential {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  service        String   // 'ledger' | 'compliance'
  encryptedToken String   @map("encrypted_token")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, service])
  @@map("tenant_backend_credentials")
}

// ============================================
// APPROVAL REQUEST
// Dual-approval on the concrete gaps this phase exists to close —
// Compliance's case-review route (today's sharpest example: reviewedBy
// is caller-supplied free text, not tied to any real identity) and
// Ledger's manual-adjustment/reversal primitives. payload is the exact
// request body the target endpoint already expects — this service
// doesn't re-validate business meaning, it only captures who requested
// what, gates who can approve it, and forwards the payload unchanged on
// approval (an unbalanced ledger entry still gets rejected by the Ledger
// itself, just at execution time instead of immediately).
// requestedById != approvedById is enforced in code, not just by role —
// the actual mechanical guarantee of segregation of duties.
// ============================================
model ApprovalRequest {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  actionType      String    @map("action_type") // 'COMPLIANCE_CASE_REVIEW' | 'LEDGER_ADJUSTMENT' | 'LEDGER_REVERSAL'
  payload         Json      // exact request body for the target endpoint
  status          String    @default("pending") // 'pending' | 'rejected' | 'approved' | 'executed' | 'failed'
  requestedById   String    @map("requested_by_id")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  executedAt      DateTime? @map("executed_at")
  executionResult Json?     @map("execution_result")
  executionError  String?   @map("execution_error")

  requestedBy StaffUser  @relation("RequestedApprovals", fields: [requestedById], references: [id])
  approvedBy  StaffUser? @relation("ApprovedApprovals", fields: [approvedById], references: [id])

  @@index([tenantId, status])
  @@map("approval_requests")
}
