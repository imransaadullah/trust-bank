# Runtime connection — must be the ledger_app role (see migrations/0003),
# never the migration owner. RLS silently does nothing for a superuser
# connection regardless of FORCE ROW LEVEL SECURITY.
DATABASE_URL=postgres://ledger_app:change-me-in-production@localhost:5432/trust_bank_ledger?sslmode=disable

# Owner/superuser connection, used only by `make migrate`. Never used at
# runtime.
MIGRATE_DATABASE_URL=postgres://postgres@localhost:5432/trust_bank_ledger?sslmode=disable

# Placeholder for the tiered publishable/secret API key model in
# AUTHCORE_SCOPED_CLIENT_KEY_SPEC.md — see internal/config for why this
# isn't sufficient past a trusted-network prototype.
LEDGER_SHARED_SECRET=change-me

PORT=8080

# How often the interest-accrual goroutine runs. Defaults to 24h in
# production; a lower value is safe for local testing since posting is
# idempotent per calendar day (see internal/accrual's package comment).
ACCRUAL_POLL_INTERVAL_MINUTES=1440
