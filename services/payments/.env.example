# Server
NODE_ENV=development
PORT=8081

# Database (own DB — separate from the Ledger's and from trustpay-backend's)
DATABASE_URL=postgresql://postgres:password@localhost:5432/trustbank_payments?schema=public

# Auth — service-to-service, same placeholder-tiering caveat as the Ledger's
# LEDGER_SHARED_SECRET (see AUTHCORE_SCOPED_CLIENT_KEY_SPEC.md for the real model)
PAYMENTS_SHARED_SECRET=change-me

# 32-byte key, hex-encoded (64 hex chars), for AES-256-GCM encryption of
# tenant provider credentials at rest. Generate with:
#   openssl rand -hex 32
PAYMENTS_ENCRYPTION_KEY=

# The Ledger service this Payments service settles into
LEDGER_SERVICE_URL=http://localhost:8080
LEDGER_SHARED_SECRET=change-me

# Reconciliation — operational tuning, not regulatory policy (doesn't go
# through services/compliance's versioned-policy model).
RECONCILIATION_POLL_INTERVAL_MINUTES=5
RECONCILIATION_STALE_MINUTES=15
RECONCILIATION_AUTO_REFUND_MINUTES=60
