# Server
NODE_ENV=development
PORT=8081

# Loopback only — never internet-facing (see deploy/NETWORK_TOPOLOGY.md).
# Override to a private/VPN interface IP only for a hybrid deployment.
BIND_HOST=127.0.0.1

# Database (own DB — separate from the Ledger's and from trustpay-backend's)
DATABASE_URL=postgresql://postgres:password@localhost:5432/trustbank_payments?schema=public

# No shared-secret env var — incoming auth is now per-caller scoped
# credentials (src/services/credentialService.js), bootstrapped via
# `node scripts/bootstrapKey.js`. See SERVICE_CREDENTIAL_MODEL.md at the
# repo root.

# 32-byte key, hex-encoded (64 hex chars), for AES-256-GCM encryption of
# tenant provider credentials at rest. Generate with:
#   openssl rand -hex 32
PAYMENTS_ENCRYPTION_KEY=

# The Ledger service this Payments service settles into — an operate-scope
# Ledger credential, not a shared secret. Issue one via the Ledger's
# POST /v1/credentials using its own admin credential.
LEDGER_SERVICE_URL=http://localhost:8080
LEDGER_API_KEY=

# Reconciliation — operational tuning, not regulatory policy (doesn't go
# through services/compliance's versioned-policy model).
RECONCILIATION_POLL_INTERVAL_MINUTES=5
RECONCILIATION_STALE_MINUTES=15
RECONCILIATION_AUTO_REFUND_MINUTES=60
