NODE_ENV=development
PORT=8083

# Loopback only — never internet-facing (see deploy/NETWORK_TOPOLOGY.md).
# Override to a private/VPN interface IP only for a hybrid deployment.
BIND_HOST=127.0.0.1

DATABASE_URL=postgresql://postgres:password@localhost:5432/trustbank_compliance?schema=public

# Placeholder — same caveat as the Ledger's and Payments' shared secrets
# (see AUTHCORE_SCOPED_CLIENT_KEY_SPEC.md).
COMPLIANCE_SHARED_SECRET=change-me
