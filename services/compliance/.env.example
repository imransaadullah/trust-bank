NODE_ENV=development
PORT=8083

# Loopback only — never internet-facing (see deploy/NETWORK_TOPOLOGY.md).
# Override to a private/VPN interface IP only for a hybrid deployment.
BIND_HOST=127.0.0.1

DATABASE_URL=postgresql://postgres:password@localhost:5432/trustbank_compliance?schema=public

# No shared-secret env var — auth is now per-caller scoped credentials
# (src/services/credentialService.js), bootstrapped via
# `node scripts/bootstrapKey.js`. See SERVICE_CREDENTIAL_MODEL.md at the
# repo root.

# How often the sanctions-feed runner refreshes OFAC/UN/Nigeria data —
# platform-wide, not tenant-specific (SanctionsWatchlistEntry has no
# tenantId). A sanctions list doesn't need minute-level freshness.
SANCTIONS_FEED_POLL_INTERVAL_HOURS=24
