generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// API KEY
// The external-facing credential a bank's own engineers hold — distinct
// from platform-admin/admin/operate (SERVICE_CREDENTIAL_MODEL.md), which
// are for internal/service-to-service callers. Same shape as
// services/compliance's ApiCredential (hashed token, shown-once,
// revocable), extended with `tier`: sandbox keys exist so a prospective
// bank can integrate before going live, production keys are the real
// thing — same distinction most BaaS providers make, and the reason this
// exists as its own model rather than reusing admin/operate.
// ============================================
model ApiKey {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  label             String
  tier              String // 'sandbox' | 'production'
  tokenPrefix       String    @unique @map("token_prefix")
  hashedToken       String    @map("hashed_token")
  status            String    @default("active")
  rateLimitPerMinute Int      @map("rate_limit_per_minute")
  createdAt         DateTime  @default(now()) @map("created_at")
  revokedAt         DateTime? @map("revoked_at")
  lastUsedAt        DateTime? @map("last_used_at")

  rateLimitCounters RateLimitCounter[]
  dailyUsage        ApiKeyDailyUsage[]

  @@index([tenantId])
  @@index([status])
  @@map("api_keys")
}

// ============================================
// RATE LIMIT COUNTER
// Postgres-backed, not Redis — no service in this platform uses anything
// but Postgres as its source of truth, and gateway traffic is nowhere
// near the volume that would justify a new piece of infra. One row per
// (apiKeyId, windowStart) — windowStart is the current minute, truncated
// to the minute boundary; a request atomically upserts-and-increments the
// row for the current window (see middleware/auth.js), so this is safe
// under concurrent requests without a separate lock.
// ============================================
model RateLimitCounter {
  id           String   @id @default(uuid())
  apiKeyId     String   @map("api_key_id")
  windowStart  DateTime @map("window_start")
  requestCount Int      @default(0) @map("request_count")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@unique([apiKeyId, windowStart])
  @@map("rate_limit_counters")
}

// ============================================
// API KEY DAILY USAGE
// The usage-transparency dashboard's own read model — Phase 6.
// RateLimitCounter only ever holds live per-minute windows (nothing
// rolls it up or reads it back historically, and nothing prunes it —
// every window since the service started otherwise stays a live row
// forever). usageRollupService aggregates every past day's counters into
// one row per (apiKeyId, date) here, then deletes the raw rows it just
// summed — closing that unbounded-growth gap as a side effect of
// building the thing a usage dashboard actually needs. tenantId is
// denormalized (not just derived via apiKey.tenantId) so a tenant-wide
// usage query never has to join through a key that's since been
// revoked. Deliberately usage counts only — no cost/quota/plan fields:
// Anchor (the closest direct BaaS competitor) runs negotiated pricing,
// not self-serve metered billing, so this is transparency, not billing.
// ============================================
model ApiKeyDailyUsage {
  id           String   @id @default(uuid())
  apiKeyId     String   @map("api_key_id")
  tenantId     String   @map("tenant_id")
  date         DateTime @map("date")
  requestCount Int      @default(0) @map("request_count")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@unique([apiKeyId, date])
  @@index([tenantId])
  @@map("api_key_daily_usage")
}

// ============================================
// TENANT BACKEND CREDENTIAL
// The gateway is multi-tenant (one process serves many bank tenants,
// unlike trustpay-backend's single-tenant-per-deployment shape) — so
// unlike trustpay-backend, which keeps one Ledger/Payments/Compliance
// operate credential per service in its own .env, the gateway needs one
// per (tenant, service), stored here. Encrypted at rest with
// GATEWAY_ENCRYPTION_KEY (src/crypto/tenantBackendCredentials.js) — same
// AES-256-GCM pattern services/payments already uses for
// TenantProviderConfig.encryptedCredentials, since this is exactly as
// sensitive: a leak here is a leak of every tenant's operate access to
// the Ledger, Payments, and Compliance.
// ============================================
model TenantBackendCredential {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  service        String // 'ledger' | 'payments' | 'compliance'
  // 'operate' (default, every existing row) is what every proxied
  // banking/decisioning call already used before this column existed.
  // 'admin' is new — a second, separate credential per (tenant, service)
  // for calls that need the issuing service's own admin scope, like
  // compliance policy publish/read. Most (tenant, service) pairs will
  // only ever have an 'operate' row; 'admin' rows exist only where a
  // self-service dashboard feature actually needs one.
  scope          String   @default("operate")
  encryptedToken String   @map("encrypted_token")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, service, scope])
  @@map("tenant_backend_credentials")
}

// ============================================
// SANDBOX TENANT
// The mapping that makes a sandbox-tier key actually isolated: a real
// tenant calling /v1/tenants/{realTenantId}/... always sees that same URL
// regardless of key tier, but a sandbox-tier key's requests get proxied
// to a *different*, synthetic tenant in Ledger/Payments/Compliance — its
// own accounts, its own data, safe to break. One synthetic twin per real
// tenant (not per key), provisioned once at onboarding time by
// deploy/provision-tenant.sh's provision_sandbox_twin, not lazily at
// request time — creating a tenant means seeding a full chart of
// accounts in the Ledger and bootstrapping credentials on three
// services, not something to do mid-request. TenantBackendCredential
// rows exist for the sandbox tenant id too, same table, just a different
// tenantId — no schema changes needed there.
// ============================================
model SandboxTenant {
  id              String   @id @default(uuid())
  realTenantId    String   @unique @map("real_tenant_id")
  sandboxTenantId String   @unique @map("sandbox_tenant_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("sandbox_tenants")
}

// ============================================
// GATEWAY SESSION
// Gateway's own first human-session concept — until now every credential
// here was a long-lived ApiKey. Issued once a pasted Identity staff
// session token (stf_live_...) has been verified server-to-server
// against Identity's own GET /v1/me (routes/staffLogin.js) for an
// ops_admin, so a tenant's admin can sign into this console without also
// holding a separate gw_live_ key. Deliberately the same shown-once/
// hashed/indexed-prefix shape, and the same 30-minute sliding idle
// timeout, as Identity's own StaffSession (services/identity/prisma/
// schema.prisma) — but a genuinely separate table and lifecycle:
// Gateway never stores or reuses the raw Identity token past the one
// verification call, so Identity's own session revocation/expiry and
// Gateway's stay fully decoupled.
// ============================================
model GatewaySession {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  staffUserId    String   @map("staff_user_id")
  staffEmail     String   @map("staff_email")
  tokenPrefix    String   @unique @map("token_prefix")
  hashedToken    String   @map("hashed_token")
  status         String   @default("active") // 'active' | 'revoked' | 'expired'
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  @@index([tenantId, status])
  @@map("gateway_sessions")
}
