generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// API KEY
// The external-facing credential a bank's own engineers hold — distinct
// from platform-admin/admin/operate (SERVICE_CREDENTIAL_MODEL.md), which
// are for internal/service-to-service callers. Same shape as
// services/compliance's ApiCredential (hashed token, shown-once,
// revocable), extended with `tier`: sandbox keys exist so a prospective
// bank can integrate before going live, production keys are the real
// thing — same distinction most BaaS providers make, and the reason this
// exists as its own model rather than reusing admin/operate.
// ============================================
model ApiKey {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  label             String
  tier              String // 'sandbox' | 'production'
  tokenPrefix       String    @unique @map("token_prefix")
  hashedToken       String    @map("hashed_token")
  status            String    @default("active")
  rateLimitPerMinute Int      @map("rate_limit_per_minute")
  createdAt         DateTime  @default(now()) @map("created_at")
  revokedAt         DateTime? @map("revoked_at")
  lastUsedAt        DateTime? @map("last_used_at")

  rateLimitCounters RateLimitCounter[]

  @@index([tenantId])
  @@index([status])
  @@map("api_keys")
}

// ============================================
// RATE LIMIT COUNTER
// Postgres-backed, not Redis — no service in this platform uses anything
// but Postgres as its source of truth, and gateway traffic is nowhere
// near the volume that would justify a new piece of infra. One row per
// (apiKeyId, windowStart) — windowStart is the current minute, truncated
// to the minute boundary; a request atomically upserts-and-increments the
// row for the current window (see middleware/auth.js), so this is safe
// under concurrent requests without a separate lock.
// ============================================
model RateLimitCounter {
  id           String   @id @default(uuid())
  apiKeyId     String   @map("api_key_id")
  windowStart  DateTime @map("window_start")
  requestCount Int      @default(0) @map("request_count")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])

  @@unique([apiKeyId, windowStart])
  @@map("rate_limit_counters")
}

// ============================================
// TENANT BACKEND CREDENTIAL
// The gateway is multi-tenant (one process serves many bank tenants,
// unlike trustpay-backend's single-tenant-per-deployment shape) — so
// unlike trustpay-backend, which keeps one Ledger/Payments/Compliance
// operate credential per service in its own .env, the gateway needs one
// per (tenant, service), stored here. Encrypted at rest with
// GATEWAY_ENCRYPTION_KEY (src/crypto/tenantBackendCredentials.js) — same
// AES-256-GCM pattern services/payments already uses for
// TenantProviderConfig.encryptedCredentials, since this is exactly as
// sensitive: a leak here is a leak of every tenant's operate access to
// the Ledger, Payments, and Compliance.
// ============================================
model TenantBackendCredential {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  service        String // 'ledger' | 'payments' | 'compliance'
  encryptedToken String   @map("encrypted_token")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, service])
  @@map("tenant_backend_credentials")
}
