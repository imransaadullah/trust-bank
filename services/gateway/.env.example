NODE_ENV=development
PORT=8084

# Loopback only by default — same as every other service — but this one
# is meant to eventually front Caddy as a *second* public entry point
# alongside trustpay-backend (external bank developers, not TrustPay's
# own consumer app). See ../../deploy/NETWORK_TOPOLOGY.md.
BIND_HOST=127.0.0.1

DATABASE_URL=postgresql://postgres:password@localhost:5432/trustbank_gateway?schema=public

# 32-byte key, hex-encoded (64 hex chars). Encrypts each tenant's stored
# Ledger/Payments/Compliance operate credential at rest — losing it means
# every tenant's gateway access needs re-provisioning, not that data is
# lost. Generate with: openssl rand -hex 32
GATEWAY_ENCRYPTION_KEY=

# The four backends this gateway proxies to. No shared API key here —
# each request uses the calling tenant's own operate credential, stored
# encrypted per-tenant (see POST /v1/tenants/:id/backend-credentials,
# provisioned by deploy/provision-tenant.sh).
LEDGER_SERVICE_URL=http://localhost:8080
PAYMENTS_SERVICE_URL=http://localhost:8081
COMPLIANCE_SERVICE_URL=http://localhost:8083
CARDS_SERVICE_URL=http://localhost:8086

# Circuit breaker tuning — one breaker per backend service, so one
# service's trouble doesn't trip the others' breakers.
CIRCUIT_BREAKER_TIMEOUT_MS=10000
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=15000
# opossum's own default is 0 — a single failing request already opens
# the circuit for everyone. Require a small minimum sample first.
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5
