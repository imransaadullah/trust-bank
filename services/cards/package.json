{
  "name": "trustbank-cards",
  "version": "0.1.0",
  "description": "trust-bank Cards service — card issuance/lifecycle orchestration behind a pluggable provider adapter. No real PAN ever touches this service; a real provider (card-issuing-as-a-service) is the only thing that would. Multi-tenant.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:deploy": "npx prisma migrate deploy",
    "postinstall": "npx prisma generate",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint src/"
  },
  "keywords": ["trustbank", "cards", "core-banking"],
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "prisma": "^6.1.0",
    "supertest": "^6.3.4"
  }
}
