# Server
NODE_ENV=development
PORT=8082

# Loopback only, even though this is the public-facing service — a
# reverse proxy (deploy/Caddyfile.example) terminates TLS and is the
# only process that binds a public interface. See
# deploy/NETWORK_TOPOLOGY.md. Override only for a hybrid deployment.
BIND_HOST=127.0.0.1

# Database (own DB, separate from the Ledger's and Payments')
DATABASE_URL=postgresql://postgres:password@localhost:5432/trustpay_backend?schema=public

# This backend's own JWT — never shared with the Ledger or Payments,
# gates every user-facing route.
TRUSTPAY_JWT_SECRET=change-me
TRUSTPAY_JWT_EXPIRY=7d

# AuthCore (phone OTP) — same account TrustChat already uses
AUTHCORE_BASE_URL=https://authcore.akoti.com.ng
AUTHCORE_PROJECT_KEY=
AUTHCORE_JWKS_URL=
AUTHCORE_PROJECT_ID=

# The one tenant id this backend acts as — provisioned once on the Ledger
# (POST /v1/tenants) and configured once on Payments
# (POST /v1/tenants/:id/config). Same value both places.
TENANT_ID=

# Operate-scope credentials issued by each service — not shared secrets.
# See SERVICE_CREDENTIAL_MODEL.md at the repo root for how to bootstrap
# and issue these.

# The Ledger service
LEDGER_SERVICE_URL=http://localhost:8080
LEDGER_API_KEY=

# The Payments service
PAYMENTS_SERVICE_URL=http://localhost:8081
PAYMENTS_API_KEY=

# The Compliance service — its tenant config (KYC-tier + device-binding
# policies) must be published before wallet routes will work; see
# services/compliance's README.
COMPLIANCE_SERVICE_URL=http://localhost:8083
COMPLIANCE_API_KEY=
