# Server
NODE_ENV=development
PORT=8087

# Loopback only — never internet-facing (see deploy/NETWORK_TOPOLOGY.md).
# Override to a private/VPN interface IP only for a hybrid deployment.
# The one exception is the public /pay/* and /v1/webhooks/* surface,
# reached via its own path-scoped Caddy site block, never this bind.
BIND_HOST=127.0.0.1

# Database (own DB — separate from every other service's)
DATABASE_URL=postgresql://postgres:password@localhost:5432/trustbank_checkout?schema=public

# The externally reachable origin for the hosted pay page and inbound
# webhooks — what a provider's callback_url/webhook URL, and this
# service's own Noop /simulate links, get built from. See
# deploy/Caddyfile.example's path-scoped checkout site block.
CHECKOUT_PUBLIC_BASE_URL=https://pay.trustbank.example.com

# No shared-secret env var — incoming auth is per-caller scoped
# credentials (src/services/credentialService.js), bootstrapped via
# `node scripts/bootstrapKey.js`. See SERVICE_CREDENTIAL_MODEL.md at the
# repo root.

# 32-byte key, hex-encoded (64 hex chars), for AES-256-GCM encryption of
# the stored per-tenant Ledger credential, checkout provider config, and
# each merchant's own webhook signing secret. Generate with:
#   openssl rand -hex 32
CHECKOUT_ENCRYPTION_KEY=

# The Ledger service this service settles into. No shared API key —
# each call uses this tenant's own operate-scope Ledger credential,
# stored encrypted per-tenant via POST /v1/tenants/:tenantId/ledger-credential
# (provisioned by deploy/provision-tenant.sh), same pattern as
# services/cards' own TenantLedgerCredential.
LEDGER_SERVICE_URL=http://localhost:8080

# How often the merchant webhook runner polls for pending deliveries,
# and how many it claims per tick.
MERCHANT_WEBHOOK_POLL_INTERVAL_SECONDS=5
MERCHANT_WEBHOOK_BATCH_SIZE=20

# How long an unpaid checkout session's hosted page stays live before it
# lazily flips to 'expired' on next read.
CHECKOUT_SESSION_DEFAULT_EXPIRY_MINUTES=30
