# Backup storage — any S3-compatible endpoint works via --endpoint-url
# (AWS S3, Backblaze B2, DigitalOcean Spaces, Cloudflare R2, MinIO). For
# real AWS S3: BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# How many days of backups to keep — pruned by backup.sh on every run.
BACKUP_RETENTION_DAYS=14

# Crash notification — any endpoint that accepts a plain JSON webhook POST
# (Slack incoming webhook, Discord webhook, most incident tools). Every
# service failing under systemd posts here (see OnFailure= in each
# service template + trustbank-notify-failure@.service.tmpl). Leave blank
# to disable — a warning is logged instead of a silent no-op.
NOTIFY_WEBHOOK_URL=

# Pair this with an external uptime monitor (UptimeRobot, healthchecks.io,
# etc.) pinging https://<your-domain>/health from outside — that's the
# only way to catch trustpay-backend being unreachable behind a dead
# reverse proxy, which still looks "successful" to systemd. Not
# configured here; see deploy/README.md.
