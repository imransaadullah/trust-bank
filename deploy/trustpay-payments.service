[Unit]
Description=trust-bank Payments Service
Documentation=https://github.com/imransaadullah/trust-bank
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/trustbank-payments
EnvironmentFile=-/home/ubuntu/apps/trustbank-payments/.env

ExecStart=/home/ubuntu/.nvm/versions/node/v24.14.1/bin/node src/index.js

Restart=always
RestartSec=5

Environment=NODE_ENV=production

StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
