[Unit]
Description=trust-bank Core Ledger Service
Documentation=https://github.com/imransaadullah/trust-bank
After=network.target postgresql.service
Wants=postgresql.service
# Fires once systemd gives up retrying (past Restart=always's default
# burst limit), not on every transient crash — see deploy/notify-failure.sh.
OnFailure=trustbank-notify-failure@%n.service

[Service]
Type=exec
User={{DEPLOY_USER}}
Group={{DEPLOY_USER}}
WorkingDirectory={{APP_ROOT}}/services/ledger
EnvironmentFile=-{{APP_ROOT}}/services/ledger/.env

ExecStart={{APP_ROOT}}/services/ledger/bin/ledger

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
