[Unit]
Description=trust-bank database backup
Documentation=https://github.com/imransaadullah/trust-bank
After=network.target postgresql.service

[Service]
Type=oneshot
User={{DEPLOY_USER}}
Group={{DEPLOY_USER}}
WorkingDirectory={{APP_ROOT}}/deploy
ExecStart={{APP_ROOT}}/deploy/backup.sh

StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true
