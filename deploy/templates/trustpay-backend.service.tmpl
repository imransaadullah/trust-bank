[Unit]
Description=TrustPay Product Backend
Documentation=https://github.com/imransaadullah/trust-bank
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User={{DEPLOY_USER}}
Group={{DEPLOY_USER}}
WorkingDirectory={{APP_ROOT}}/services/trustpay-backend
EnvironmentFile=-{{APP_ROOT}}/services/trustpay-backend/.env

ExecStart={{NODE_BIN}} src/index.js

Restart=always
RestartSec=5

Environment=NODE_ENV=production

StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
